{
  "name": "slobs-client",
  "productName": "Streamlabs Desktop",
  "description": "Streamlabs streaming software",
  "author": "General Workings, Inc.",
  "license": "GPL-3.0",
  "version": "1.22.4",
  "main": "build/main/index.js",
  "macVirtualCamUrl": "https://obs-studio-deployment.s3.us-west-2.amazonaws.com/slobs-vcam-installer-1.0.18-release-osx-[ARCH].tar.gz",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "build:updater": "node -e \"require('fs').rmSync('updater/build',{recursive:true,force:true})\" && tsc -p updater",
    "start": "electron .",
    "package": "node scripts/package.mjs",
    "package:nosign": "node scripts/package.mjs --nosign",
    "package:poc": "node scripts/package.mjs --poc",
    "test:hotfix": "node scripts/test-hotfix.mjs",
    "smoke": "node scripts/smoke.mjs",
    "test:collections": "node scripts/test-collections.mjs",
    "test:meters": "node scripts/test-meters.mjs",
    "test:dialogs": "node scripts/test-dialogs-e2e.mjs",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "postinstall": "node ./scripts/postinstall.js",
    "test": "vitest run"
  },
  "prettier": {
    "singleQuote": true,
    "printWidth": 100,
    "endOfLine": "lf",
    "trailingComma": "all",
    "arrowParens": "avoid"
  },
  "dependencies": {
    "abort-controller": "^3.0.0",
    "color-picker": "https://obs-studio-deployment.s3-us-west-2.amazonaws.com/color-picker-0.0.0.tar.gz",
    "crash-handler": "https://slobs-crash-handler.s3-us-west-2.amazonaws.com/crash-handler-0.0.0.tar.gz",
    "electron-updater": "^4.2.0",
    "font-manager": "https://slobs-font-manager.s3-us-west-2.amazonaws.com/font-manager-0.0.0.tar.gz",
    "fs-extra": "^9.0.0",
    "game_overlay": "https://obs-studio-deployment.s3-us-west-2.amazonaws.com/game-overlay-v0.0.0.tar.gz",
    "node-fetch": "^2.6.1",
    "node-fontinfo": "https://slobs-node-fontinfo.s3-us-west-2.amazonaws.com/node-fontinfo-0.0.0.tar.gz",
    "node-libuiohook": "https://slobs-node-libuiohook.s3-us-west-2.amazonaws.com/node-libuiohook-0.0.0.tar.gz",
    "node-screenshots": "^0.2.1",
    "node-window-rendering": "https://slobs-node-window-rendering.s3-us-west-2.amazonaws.com/node-window-rendering-0.0.0.tar.gz",
    "obs-studio-node": "https://s3-us-west-2.amazonaws.com/obsstudionodes3.streamlabs.com/osn-0.0.0-release.tar.gz",
    "realm": "12.7.1",
    "semver": "^5.5.1",
    "tasklist": "^3.1.1"
  },
  "optionalDependencies": {
    "node-win32-np": "1.0.6"
  },
  "devDependencies": {
    "@electron/notarize": "^3.1.2",
    "@eslint/js": "^9.39.5",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^24.19.2",
    "@types/node-fetch": "^2.5.10",
    "@types/semver": "^7.8.0",
    "@unocss/preset-wind3": "^66.13.0",
    "@unocss/reset": "^66.13.0",
    "@unocss/transformer-directives": "^66.13.0",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/test-utils": "^2.6.0",
    "@vueuse/core": "^15.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "colors": "^1.4.0",
    "electron": "45.4.1",
    "electron-builder": "26.15.7",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.18.1",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-vue": "^10.12.1",
    "glob": "^14.0.6",
    "globals": "^17.14.0",
    "happy-dom": "^21.0.4",
    "pinia": "^4.1.0",
    "prettier": "^3.10.1",
    "recursive-readdir": "^2.2.3",
    "reka-ui": "^2.11.0",
    "rimraf": "^3.0.2",
    "shelljs": "^0.10.0",
    "signtool": "^1.0.0",
    "tailwind-merge": "^3.7.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0",
    "unocss": "^66.13.0",
    "unocss-preset-animations": "^1.3.0",
    "unocss-preset-shadcn": "^0.5.0",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^7.3.8",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^3.2.7",
    "vue": "^3.5.45",
    "vue-eslint-parser": "^10.4.2",
    "vue-router": "^5.5.1",
    "vue-tsc": "^3.3.14"
  }
}
